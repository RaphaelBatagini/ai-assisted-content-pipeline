# Application
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blogs_tool
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Fase 1)
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme-refresh

# Frontend
FRONTEND_URL=http://localhost:3000
LANDING_URL=http://localhost:3002

# Stripe (Fase 2)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# AWS (Fase 5)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Static site generator (Fase 5)
STATIC_SITES_BUCKET=my-static-sites-bucket
CF_DISTRIBUTION_ID=EXXXXXXXXX
SITE_BASE_URL_TEMPLATE=https://{slug}.example.com
SITE_TEMPLATE_DIR=../site-template
BUILDS_BASE_DIR=/tmp/builds
BUILD_CONCURRENCY=1

# E-mail (Fase 3)
RESEND_API_KEY=re_...
