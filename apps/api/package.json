{
  "name": "blogs-tool-api",
  "version": "0.1.0",
  "description": "Blogs Tool API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "worker": "node src/workers/buildWorker.js",
    "worker:dev": "nodemon src/workers/buildWorker.js",
    "worker:ai": "node src/workers/aiWorker.js",
    "worker:ai:dev": "nodemon src/workers/aiWorker.js",
    "worker:analytics": "node src/workers/analyticsWorker.js",
    "worker:analytics:dev": "nodemon src/workers/analyticsWorker.js",
    "worker:google": "node src/workers/googleWorker.js",
    "worker:google:dev": "nodemon src/workers/googleWorker.js",
    "migrate": "sequelize db:migrate",
    "migrate:undo": "sequelize db:migrate:undo:all",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "stripe:listen": "stripe listen --forward-to localhost:3001/api/payment/webhook",
    "stripe:trigger:checkout": "stripe trigger checkout.session.completed",
    "stripe:trigger:subscription:updated": "stripe trigger customer.subscription.updated"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1037.0",
    "@aws-sdk/client-s3": "^3.1036.0",
    "@google-analytics/data": "^5.2.2",
    "@google/generative-ai": "^0.21.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^8.4.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^2.1.35",
    "multer": "^2.1.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "resend": "^6.12.2",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
